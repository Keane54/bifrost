{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noImplicitAny": true,
    "types": ["node"]
  },
  "exclude": ["test/smoke/**"],
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["test/**/*.ts", "src/renderer/src/env.d.ts", "src/preload/*.d.ts"]
}
