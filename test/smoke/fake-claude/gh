#!/bin/sh
# The fake gh of the smoke test. The smoke test puts this folder first on the PATH of Bifrost.
# The script answers the poll of the Reviews panel with fixed JSON. The first poll gets
# reviews-1.json. Each later poll gets reviews-2.json, which has one more direct request. The
# script does not call GitHub.
#
# A request flashes only when its request event is after the turn-on. So the script puts the
# time of the first later poll in place of @ASKED@ in reviews-2.json. It keeps that time in the
# test home, so each later poll gives the same time and the request is not a re-request.

dir=$(cd "$(dirname "$0")" && pwd)

if [ "$#" -ge 3 ] && [ "$1 $2 $3" = 'api graphql -f' ]; then
  # A counter file in the test home tells the first poll from a later poll.
  counter="${BIFROST_TEST_HOME:-/dev/null}/gh-polls"
  count=0
  if [ -f "$counter" ]; then
    count=$(cat "$counter")
  fi
  count=$((count + 1))
  if [ -n "${BIFROST_TEST_HOME:-}" ]; then
    echo "$count" >"$counter"
  fi
  if [ "$count" -eq 1 ]; then
    cat "$dir/../fixtures/reviews-1.json"
  else
    asked=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -n "${BIFROST_TEST_HOME:-}" ]; then
      stamp="$BIFROST_TEST_HOME/gh-asked"
      if [ ! -f "$stamp" ]; then
        echo "$asked" >"$stamp"
      fi
      asked=$(cat "$stamp")
    fi
    sed "s/@ASKED@/$asked/" "$dir/../fixtures/reviews-2.json"
  fi
  exit 0
fi

# The Show Info panel asks for the PR of a session folder.
if [ "$*" = 'pr view --json number,title,url,state' ]; then
  echo 'no pull requests found' >&2
  exit 1
fi

# An unknown call goes to stderr and to a file in the test home. The smoke test checks that the
# file is empty or absent.
echo "fake gh: unknown call: $*" >&2
if [ -n "${BIFROST_TEST_HOME:-}" ]; then
  echo "gh $*" >>"$BIFROST_TEST_HOME/unknown.log"
fi
exit 2
