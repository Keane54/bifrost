#!/bin/sh
# The fake gh of the smoke test. The smoke test puts this folder first on the PATH of Bifrost.
# The script gives fixed JSON and does not call GitHub. It has two modes.
#
# The R1 mode answers the poll of the Reviews panel. The first poll gets reviews-1.json. Each
# later poll gets reviews-2.json, which has one more direct request. A request flashes only when
# its request event is after the turn-on. So the script puts the time of the first later poll in
# place of @ASKED@ in reviews-2.json. It keeps that time in the test home, so each later poll
# gives the same time and the request is not a re-request.
#
# The review-round mode applies when the file gh-fixtures in the test home holds review-round.
# The script tells the GraphQL calls apart by the operation name in the query text. The poll gets
# review-round-poll-1.json until the post of the review, then review-round-poll-2.json. The
# ReviewContext query gets review-context.json. The create of a pending review saves stdin to
# review-post.json. Each fixture gets the content of smoke-head in place of @HEAD@.
#
# The approve-round mode applies when gh-fixtures holds approve-round. It is the review-round mode
# with an Approve result of the fake claude. After the post of the review, the ReviewContext query
# gets review-context-draft.json, which has the draft review of Bifrost as the pending review of
# the viewer. The ApproveDraft write saves the file gh-approved in the test home and gives a good
# answer. After that write, the poll gets review-round-poll-3.json, which has no pending review
# and an approval of the viewer on the head. Each poll after the write adds one line to
# gh-polls-approved, so the smoke test can wait for a poll.
#
# The approve-head-round mode is the same with an Approve result that has nothing to post. So no
# draft review exists, and the ApproveHead write approves the head with no text. It saves
# gh-approved in the same way.
#
# In the review-round mode, the Review panel (user decision, 2026-11-13) can send the draft. After
# the post of the review, the ReviewContext query gets review-context-draft.json, and the
# DraftReview query gets review-draft.json. The EditBody write gives a good answer. The
# SendChanges write saves the file gh-sent in the test home and gives a good answer. After that
# write, the poll gets review-round-poll-sent.json, which has no review request. Each poll after
# the write adds one line to gh-polls-sent.
#
# The request-round mode applies when gh-fixtures holds request-round. The first poll gets
# request-round-poll-1.json. Each later poll gets request-round-poll-2.json, which has one new
# review thread. The script puts the time of the first later poll in place of @CREATED@, and it
# keeps that time in the test home. The RequestContext, RequestThreads and RequestComments
# queries get their fixtures. After the ResolveThread write, the poll and RequestThreads show the
# thread as resolved. The four writes of a request round get a good answer.
#
# In the request-round mode, the signed commit write (api graphql --input -) acts as GitHub with
# createCommitOnBranch. The script saves stdin to gh-commit.json. It makes the commit in the bare
# remote of acme/api with git: one parent (expectedHeadOid), one added file as a regular file, and
# the headline as the message. The ref moves only from expectedHeadOid. The script reads the JSON
# with sed, so it knows only the form that Bifrost sends for one added file and no delete.
#
# Each write call goes to gh-writes.log in the test home, in all modes. A write call is an api
# call with a method that is not GET, an api call with a field or an input and no method (gh sends
# it as POST), a GraphQL mutation (the word mutation in a query field, in any case), or a pr call
# that is not pr view. The read queries of Bifrost send their fields as POST too. Only their exact
# forms are reads.

dir=$(cd "$(dirname "$0")" && pwd)
home=${BIFROST_TEST_HOME:-}

# True for the exact form of a read query of Bifrost: the Poll query with no field, or the query
# field of a PR query or of the ThreadComments query, then only the known fields of that query.
is_read_query() {
  [ "$#" -ge 4 ] && [ "$1 $2 $3" = 'api graphql -f' ] || return 1
  case "$4" in
    'query=query Poll {'*)
      [ "$#" -eq 4 ]
      return
      ;;
    'query=query ReviewContext('* | 'query=query RequestContext('*) known=pr ;;
    'query=query RequestThreads('* | 'query=query RequestComments('*) known=pr ;;
    'query=query ThreadComments('* | 'query=query DraftReview('*) known=node ;;
    *) return 1 ;;
  esac
  shift 4
  while [ "$#" -ge 2 ]; do
    case "$known:$1 $2" in
      'pr:-f owner='* | 'pr:-f repo='* | 'pr:-F number='* | 'pr:-f login='*) ;;
      'pr:-F head='* | 'pr:-f after='* | 'node:-f id='* | 'node:-f after='*) ;;
      *) return 1 ;;
    esac
    shift 2
  done
  [ "$#" -eq 0 ]
}

# Do the signed commit write of the request-round mode on the bare remote, and print the answer.
signed_commit() {
  body=$(cat)
  printf '%s' "$body" >"$home/gh-commit.json"
  expected=$(printf '%s\n' "$body" | sed -n 's/.*"expectedHeadOid":"\([0-9a-f]*\)".*/\1/p')
  contents=$(printf '%s\n' "$body" | sed -n 's/.*"additions":\[{"contents":"\([^"]*\)".*/\1/p')
  pattern='s/.*"additions":\[{"contents":"[^"]*","path":"\([^"]*\)"}\].*/\1/p'
  path=$(printf '%s\n' "$body" | sed -n "$pattern")
  headline=$(printf '%s\n' "$body" | sed -n 's/.*"headline":"\([^"]*\)".*/\1/p')
  bare="$home/git-remotes/acme/api.git"
  index="$home/gh-commit-index"
  GIT_CONFIG_GLOBAL=/dev/null
  GIT_CONFIG_NOSYSTEM=1
  GIT_AUTHOR_NAME='Fake GitHub'
  GIT_AUTHOR_EMAIL=fake-github@example.invalid
  GIT_COMMITTER_NAME='Fake GitHub'
  GIT_COMMITTER_EMAIL=fake-github@example.invalid
  export GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL
  export GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
  now=$(git --git-dir="$bare" rev-parse --verify refs/heads/feature)
  if [ -z "$expected" ] || [ -z "$path" ] || [ -z "$headline" ] || [ "$now" != "$expected" ]; then
    echo '{"data":{"createCommitOnBranch":null},"errors":[{"message":"Expected another head."}]}'
    return 1
  fi
  printf '%s' "$contents" | base64 --decode >"$home/gh-commit-blob" || return 1
  blob=$(git --git-dir="$bare" hash-object -w --no-filters -- "$home/gh-commit-blob") || return 1
  GIT_INDEX_FILE=$index git --git-dir="$bare" read-tree "$now" || return 1
  GIT_INDEX_FILE=$index git --git-dir="$bare" update-index --add --cacheinfo "100644,$blob,$path" ||
    return 1
  tree=$(GIT_INDEX_FILE=$index git --git-dir="$bare" write-tree) || return 1
  oid=$(git --git-dir="$bare" commit-tree "$tree" -p "$now" -m "$headline") || return 1
  git --git-dir="$bare" update-ref refs/heads/feature "$oid" "$now" || return 1
  printf '{"data":{"createCommitOnBranch":{"commit":{"oid":"%s"}}}}\n' "$oid"
}

# Print a fixture of the request-round mode with the head commit and the time of the new thread
# in place. The first call after the first poll saves that time in the test home. After the
# ResolveThread write, the thread shows as resolved.
request_fixture() {
  stamp="$home/gh-created"
  if [ ! -f "$stamp" ]; then
    date -u +%Y-%m-%dT%H:%M:%SZ >"$stamp"
  fi
  created=$(cat "$stamp")
  resolved=false
  if [ -f "$home/gh-resolved" ]; then
    resolved=true
  fi
  sed -e "s/@HEAD@/$(cat "$home/smoke-head")/g" -e "s/@CREATED@/$created/g" \
    -e "s/\"isResolved\": false/\"isResolved\": $resolved/" "$dir/../fixtures/$1"
}

write=no
method=no
fields=no
prev=''
for arg in "$@"; do
  case "$prev" in
    --method | -X)
      method=yes
      [ "$arg" = GET ] || write=yes
      ;;
  esac
  case "$arg" in
    --method=GET | -XGET) method=yes ;;
    --method=* | -X?*)
      method=yes
      write=yes
      ;;
    -f | -F | --field | --raw-field | --input | -f?* | -F?* | --field=* | --raw-field=* | --input=*)
      fields=yes
      ;;
  esac
  lower=$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    query=*mutation*) write=yes ;;
  esac
  prev=$arg
done
if [ "${1:-}" = api ] && [ "$fields" = yes ] && [ "$method" = no ] && ! is_read_query "$@"; then
  write=yes
fi
if [ "${1:-}" = pr ] && [ "${2:-}" != view ]; then
  write=yes
fi
if [ "$write" = yes ] && [ -n "$home" ]; then
  # A GraphQL query has line breaks. The log keeps one line for each call.
  printf '%s' "$*" | tr '\n' ' ' >>"$home/gh-writes.log"
  echo >>"$home/gh-writes.log"
fi

mode=''
if [ -n "$home" ] && [ -f "$home/gh-fixtures" ]; then
  mode=$(cat "$home/gh-fixtures")
fi

if [ "$mode" = review-round ] || [ "$mode" = approve-round ] || [ "$mode" = approve-head-round ]
then
  head=$(cat "$home/smoke-head")
  if [ "$#" -ge 4 ] && [ "$1 $2 $3" = 'api graphql -f' ]; then
    case "$4" in
      'query=query Poll {'*)
        poll=review-round-poll-1.json
        if [ -f "$home/gh-sent" ]; then
          poll=review-round-poll-sent.json
          echo poll >>"$home/gh-polls-sent"
        elif [ -f "$home/gh-approved" ]; then
          poll=review-round-poll-3.json
          echo poll >>"$home/gh-polls-approved"
        elif [ -f "$home/review-post.json" ]; then
          poll=review-round-poll-2.json
        fi
        sed "s/@HEAD@/$head/g" "$dir/../fixtures/$poll"
        exit 0
        ;;
      'query=query ReviewContext('*)
        context=review-context.json
        if [ "$mode" != approve-head-round ] && [ -f "$home/review-post.json" ]; then
          context=review-context-draft.json
        fi
        sed "s/@HEAD@/$head/g" "$dir/../fixtures/$context"
        exit 0
        ;;
      'query=query DraftReview('*)
        sed "s/@HEAD@/$head/g" "$dir/../fixtures/review-draft.json"
        exit 0
        ;;
      'query=mutation EditBody('*)
        if [ "$mode" = review-round ]; then
          review='{"pullRequestReview":{"id":"PRR_fake","state":"PENDING"}}'
          printf '{"data":{"updatePullRequestReview":%s}}\n' "$review"
          exit 0
        fi
        ;;
      'query=mutation SendChanges('*)
        if [ "$mode" = review-round ]; then
          : >"$home/gh-sent"
          review='{"pullRequestReview":{"id":"PRR_fake","state":"CHANGES_REQUESTED"}}'
          printf '{"data":{"submitPullRequestReview":%s}}\n' "$review"
          exit 0
        fi
        ;;
      'query=mutation ApproveDraft('*)
        if [ "$mode" = approve-round ]; then
          : >"$home/gh-approved"
          review='{"pullRequestReview":{"id":"PRR_fake","state":"APPROVED"}}'
          printf '{"data":{"submitPullRequestReview":%s}}\n' "$review"
          exit 0
        fi
        ;;
      'query=mutation ApproveHead('*)
        if [ "$mode" = approve-head-round ]; then
          : >"$home/gh-approved"
          review='{"pullRequestReview":{"id":"PRR_head","state":"APPROVED"}}'
          printf '{"data":{"addPullRequestReview":%s}}\n' "$review"
          exit 0
        fi
        ;;
    esac
  fi
  if [ "$*" = 'api --method POST repos/acme/api/pulls/7/reviews --input -' ]; then
    cat >"$home/review-post.json"
    echo '{"node_id":"PRR_fake","state":"PENDING","html_url":"https://github.com/acme/api/pull/7"}'
    exit 0
  fi
elif [ "$mode" = request-round ]; then
  if [ "$*" = 'api graphql --input -' ]; then
    signed_commit
    exit
  fi
  if [ "$#" -ge 4 ] && [ "$1 $2 $3" = 'api graphql -f' ]; then
    case "$4" in
      'query=query Poll {'*)
        # A counter file in the test home tells the first poll from a later poll. The smoke test
        # reads it to wait for a poll.
        count=$(cat "$home/gh-polls" 2>/dev/null)
        count=$((${count:-0} + 1))
        if [ "$count" -eq 1 ]; then
          sed "s/@HEAD@/$(cat "$home/smoke-head")/g" "$dir/../fixtures/request-round-poll-1.json"
        else
          request_fixture request-round-poll-2.json
        fi
        echo "$count" >"$home/gh-polls"
        exit 0
        ;;
      'query=query RequestContext('*)
        request_fixture request-context.json
        exit 0
        ;;
      'query=query RequestThreads('*)
        request_fixture request-threads.json
        exit 0
        ;;
      'query=query RequestComments('*)
        request_fixture request-comments.json
        exit 0
        ;;
      'query=mutation ReplyToThread('*)
        comment="{\"createdAt\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"id\":\"PRRC_fake\","
        comment="$comment\"state\":\"SUBMITTED\"}"
        printf '{"data":{"addPullRequestReviewThreadReply":{"comment":%s}}}\n' "$comment"
        exit 0
        ;;
      'query=mutation ResolveThread('*)
        : >"$home/gh-resolved"
        echo '{"data":{"resolveReviewThread":{"thread":{"id":"PRRT_fake1","isResolved":true}}}}'
        exit 0
        ;;
      'query=mutation CommentOnPr('*)
        node="{\"createdAt\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"id\":\"IC_fake\"}"
        printf '{"data":{"addComment":{"commentEdge":{"node":%s}}}}\n' "$node"
        exit 0
        ;;
      'query=mutation RequestReviewer('*)
        echo '{"data":{"requestReviews":{"pullRequest":{"id":"PR_fake9"}}}}'
        exit 0
        ;;
    esac
  fi
elif [ "$#" -ge 3 ] && [ "$1 $2 $3" = 'api graphql -f' ]; then
  # A counter file in the test home tells the first poll from a later poll.
  counter="${home:-/dev/null}/gh-polls"
  count=0
  if [ -f "$counter" ]; then
    count=$(cat "$counter")
  fi
  count=$((count + 1))
  if [ -n "$home" ]; then
    echo "$count" >"$counter"
  fi
  if [ "$count" -eq 1 ]; then
    cat "$dir/../fixtures/reviews-1.json"
  else
    asked=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -n "$home" ]; then
      stamp="$home/gh-asked"
      if [ ! -f "$stamp" ]; then
        echo "$asked" >"$stamp"
      fi
      asked=$(cat "$stamp")
    fi
    sed "s/@ASKED@/$asked/" "$dir/../fixtures/reviews-2.json"
  fi
  exit 0
fi

# The Show Info panel asks for the PR of a session folder.
if [ "$*" = 'pr view --json number,title,url,state' ]; then
  echo 'no pull requests found' >&2
  exit 1
fi

# An unknown call goes to stderr and to a file in the test home. The smoke test checks that the
# file is empty or absent.
echo "fake gh: unknown call: $*" >&2
if [ -n "$home" ]; then
  echo "gh $*" >>"$home/unknown.log"
fi
exit 2
