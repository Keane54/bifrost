{
  "author": "Bifrost",
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@fontsource/geist-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "description": "A macOS app that lists and controls local Claude Code sessions.",
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-hotkeys": "0.16.0",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lefthook": "2.2.2",
    "lucide-react": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "name": "bifrost",
  "packageManager": "pnpm@12.3.4",
  "private": true,
  "productName": "Bifrost",
  "scripts": {
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "check": "biome check",
    "check:write": "biome check --write",
    "dev": "electron-vite dev",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "format": "biome format",
    "format:write": "biome format --write",
    "icon": "node scripts/make-icon.ts",
    "lint": "biome lint",
    "lint:write": "biome lint --write",
    "postinstall": "node scripts/postinstall.ts",
    "prepare": "lefthook install",
    "smoke": "electron-vite build && playwright test",
    "smoke:app": "playwright test",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:scripts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "type": "module",
  "version": "0.1.0"
}
